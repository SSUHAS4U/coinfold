# Copy to .env and fill in. Never commit the filled copy.
DATABASE_URL=postgresql://user:password@host:5432/coinfold
# 32+ random characters. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Comma-separated. No wildcard: credentialed CORS rejects "*" anyway.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development
